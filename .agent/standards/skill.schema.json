{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pikakit.com/schemas/skill-v2.json",
  "title": "PikaKit Skill Descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "metadata"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 40, "maxLength": 1024 },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "schema_version", "type", "category", "risk_tier", "version",
        "author", "triggers", "negative_triggers", "coordinates_with",
        "capabilities", "platforms", "last_reviewed", "review_interval_days"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)?$" },
        "schema_version": { "const": "2.0.0" },
        "type": { "enum": ["knowledge", "executable", "hybrid"] },
        "category": {
          "enum": [
            "architecture", "frontend", "backend", "data", "mobile", "design",
            "quality", "security", "delivery", "operations", "agentic",
            "knowledge", "content", "game", "meta"
          ]
        },
        "risk_tier": { "enum": ["critical", "high", "standard"] },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "author": { "type": "string", "minLength": 1 },
        "triggers": { "$ref": "#/$defs/positiveTriggers" },
        "negative_triggers": { "$ref": "#/$defs/negativeTriggers" },
        "coordinates_with": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "capabilities": { "$ref": "#/$defs/nonEmptyStrings" },
        "platforms": { "$ref": "#/$defs/nonEmptyStrings" },
        "last_reviewed": { "type": "string", "format": "date" },
        "review_interval_days": { "enum": [90, 180, 365] }
      },
      "allOf": [
        { "if": { "properties": { "risk_tier": { "const": "critical" } }, "required": ["risk_tier"] }, "then": { "properties": { "review_interval_days": { "const": 90 } } } },
        { "if": { "properties": { "risk_tier": { "const": "high" } }, "required": ["risk_tier"] }, "then": { "properties": { "review_interval_days": { "const": 180 } } } },
        { "if": { "properties": { "risk_tier": { "const": "standard" } }, "required": ["risk_tier"] }, "then": { "properties": { "review_interval_days": { "const": 365 } } } }
      ]
    }
  },
  "$defs": {
    "positiveTriggers": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "negativeTriggers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
